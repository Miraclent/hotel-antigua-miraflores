# ───────────────────────────────────────────────────────────────
# Configuración del chatbot con IA (Hotel Antigua Miraflores)
#
# 1. Copia este archivo y renómbralo como  .env  (sin .example)
# 2. Pega tu API key de Anthropic (https://console.anthropic.com → API Keys)
# 3. Guarda y ejecuta:  npm start
# ───────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# Opcional: modelo a usar (por defecto claude-haiku-4-5, rápido y económico)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Opcional: puerto del servidor (por defecto 3000)
# PORT=3000
